						<property name="spacing">24</property>
						<child>
							<object id="box:attribute:technical" class="GtkBox">
								<property name="orientation">1</property>
								<property name="spacing">6</property>
								<child>
									<object class="GtkLabel">
										<property name="label">TECHNICAL</property>
										<property name="css-classes">caption-heading
											section-heading
										</property>
										<property name="halign">1</property>
									</object>
								</child>
								<child>
									<object class="GtkSeparator">
										<property name="css-classes">accent-rule</property>
									</object>
								</child>
								<child>
									<object class="GtkListBox">
										<property name="css-classes">attribute-list</property>
										<property name="selection-mode">0</property>
										<child>
											<object class="GtkBox" id="row:attribute:technical:corners">
												<property name="css-classes">attr-row</property>
												<child>
													<object class="GtkLabel">
														<property name="label">Corners</property>
														<property name="hexpand">true</property>
														<property name="xalign">0</property>
