<?xml version="1.0" encoding="UTF-8"?>
<!--
  Yet another Scouting Tool - GTK4 GtkBuilder UI definition.
  See: https://docs.gtk.org/gtk4/class.Builder.html
-->
<interface domain="player-info">
	<!-- interface-name player-info.ui -->
	<!-- interface-copyright SPDX-FileCopyrightText: © 2026 Phil Armstead <philarmstead@mailbox.org>
SPDX-License-Identifier: GPL-3.0-or-later -->
	<!-- interface-authors Phil Armstead <philarmstead@mailbox.org> -->
	<requires lib="gtk" version="4.0"/>
	<object class="GtkWindow" id="window:player-info">
		<property name="default-width">420</property>
		<property name="title">Yet another Scouting Tool</property>
		<property name="css-classes">app-root</property>
		<child>
			<object class="GtkBox">
				<property name="orientation">1</property>
				<property name="spacing">16</property>
				<property name="css-classes">card
					card-border
				</property>
				<child>
					<object class="GtkBox">
						<property name="orientation">0</property>
						<property name="homogeneous">true</property>
						<child>
							<object class="GtkBox">
								<property name="orientation">1</property>
								<property name="valign">1</property>
								<property name="spacing">4</property>
								<child>
									<object class="GtkBox">
										<property name="valign">1</property>
										<property name="spacing">8</property>
										<child>
											<object class="GtkLabel" id="label:common-name">
												<property name="label"/>
												<style>
													<class name="title-1"/>
												</style>
												<property name="halign">1</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object id="label:nationality" class="GtkBox">
												<property name="halign">2</property>
												<property name="spacing">4</property>
												<property name="css-classes">nationality</property>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="halign">1</property>
										<property name="spacing">6</property>
										<child>
											<object class="GtkLabel" id="label:club-name">
												<property name="label"/>
												<property name="tooltip-text">Show this club's players</property>
												<style>
													<class name="heading"/>
													<class name="clickable"/>
												</style>
												<property name="halign">1</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">•</property>
												<style>
													<class name="meta-separator"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkLabel" id="label:age">
												<property name="label"/>
												<style>
													<class name="player-vital"/>
												</style>
												<property name="halign">1</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">•</property>
												<style>
													<class name="meta-separator"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkLabel" id="label:height">
												<property name="label"/>
												<style>
													<class name="player-vital"/>
												</style>
												<property name="halign">1</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">•</property>
												<style>
													<class name="meta-separator"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkLabel" id="label:weight">
												<property name="label"/>
												<style>
													<class name="player-vital"/>
												</style>
												<property name="halign">1</property>
												<property name="xalign">0</property>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkLabel" id="label:contract">
										<property name="halign">1</property>
										<property name="xalign">0</property>
										<style>
											<class name="player-contract"/>
										</style>
									</object>
								</child>
							</object>
						</child>
						<child>
							<object class="GtkBox">
								<property name="orientation">1</property>
								<property name="valign">1</property>
								<property name="halign">2</property>
								<property name="spacing">4</property>
								<child>
									<object id="widget:is-fast-learner" class="GtkBox">
										<property name="halign">2</property>
										<property name="css-classes">pill-fast-learner</property>
										<child>
											<object class="GtkLabel" id="label:is-fast-learner">
												<property name="label">🧠 Fast Learner</property>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object id="widget:is-hot-prospect" class="GtkBox">
										<property name="halign">2</property>
										<property name="css-classes">pill-hot-prospect</property>
										<child>
											<object class="GtkLabel" id="label:is-hot-prospect">
												<property name="label">🔥 Hot Prospect</property>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object id="widget:transfer-status" class="GtkBox">
										<property name="halign">2</property>
										<property name="css-classes">pill-transfer</property>
										<child>
											<object class="GtkLabel" id="label:transfer-status"/>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="halign">2</property>
										<property name="spacing">6</property>
										<property name="margin-top">4</property>
										<child>
											<object class="GtkButton" id="button:shortlist">
												<property name="tooltip-text">Track this player's progress in the Shortlist (Ctrl+S)</property>
												<style>
													<class name="btn-secondary"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkButton" id="button:similar">
												<property name="label">Similar players</property>
												<property name="tooltip-text">Find players with a similar attribute profile</property>
												<style>
													<class name="btn-secondary"/>
												</style>
											</object>
										</child>
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkLabel" id="label:tracking">
						<property name="visible">false</property>
						<property name="halign">1</property>
						<property name="xalign">0</property>
						<property name="wrap">true</property>
						<style>
							<class name="tracking-summary"/>
						</style>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">0</property>
						<property name="css-classes">panel</property>
						<property name="spacing">12</property>
						<child>
							<object class="GtkGrid">
								<property name="hexpand">true</property>
								<property name="column-homogeneous">true</property>
								<child>
									<object class="GtkBox">
										<property name="orientation">1</property>
										<child>
											<object class="GtkLabel">
												<property name="label">CA</property>
												<property name="css-classes">caption-heading
													dim-label
												</property>
												<property name="width-chars">10</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel" id="label:ca">
												<property name="css-classes">current-ability</property>
											</object>
										</child>
										<layout>
											<property name="column">0</property>
											<property name="row">0</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">1</property>
										<child>
											<object class="GtkLabel">
												<property name="label">PA</property>
												<property name="css-classes">caption-heading
													dim-label
												</property>
												<property name="width-chars">10</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel" id="label:pa">
												<property name="css-classes">potential-ability</property>
											</object>
										</child>
										<layout>
											<property name="column">1</property>
											<property name="row">0</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">1</property>
										<property name="spacing">4</property>
										<child>
											<object class="GtkLabel">
												<property name="label">Footedness</property>
												<property name="css-classes">caption-heading
													dim-label
												</property>
												<property name="width-chars">10</property>
											</object>
										</child>
										<child>
											<object class="GtkBox" id="box:footedness">
												<property name="orientation">0</property>
												<property name="spacing">4</property>
												<property name="halign">3</property>
											</object>
										</child>
										<layout>
											<property name="column">2</property>
											<property name="row">0</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">1</property>
										<property name="spacing">4</property>
										<child>
											<object class="GtkLabel">
												<property name="label">Morale</property>
												<property name="css-classes">caption-heading
													dim-label
												</property>
												<property name="width-chars">10</property>
											</object>
										</child>
										<child>
											<object class="GtkBox" id="box:morale">
												<property name="orientation">0</property>
												<property name="spacing">4</property>
												<property name="halign">3</property>
											</object>
										</child>
										<layout>
											<property name="column">3</property>
											<property name="row">0</property>
										</layout>
									</object>
								</child>
							</object>
						</child>
						<child>
							<object class="GtkGrid">
								<property name="valign">2</property>
								<property name="column-spacing">8</property>
								<child>
									<object class="GtkLabel">
										<property name="label">Condition:</property>
										<property name="xalign">1</property>
										<property name="css-classes">dim-label</property>
										<layout>
											<property name="column">0</property>
											<property name="row">0</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkLabel" id="label:condition">
										<property name="xalign">1</property>
										<property name="width-chars">4</property>
										<property name="css-classes">caption-heading</property>
										<layout>
											<property name="column">1</property>
											<property name="row">0</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkLabel">
										<property name="label">Sharpness:</property>
										<property name="xalign">1</property>
										<property name="css-classes">dim-label</property>
										<layout>
											<property name="column">0</property>
											<property name="row">1</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkLabel" id="label:sharpness">
										<property name="xalign">1</property>
										<property name="width-chars">4</property>
										<property name="css-classes">caption-heading</property>
										<layout>
											<property name="column">1</property>
											<property name="row">1</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkLabel">
										<property name="label">Fatigue:</property>
										<property name="xalign">1</property>
										<property name="css-classes">dim-label</property>
										<layout>
											<property name="column">0</property>
											<property name="row">2</property>
										</layout>
									</object>
								</child>
								<child>
									<object class="GtkLabel" id="label:fatigue">
										<property name="xalign">1</property>
										<property name="width-chars">4</property>
										<property name="css-classes">caption-heading</property>
										<layout>
											<property name="column">1</property>
											<property name="row">2</property>
										</layout>
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">1</property>
						<property name="spacing">6</property>
						<child>
							<object class="GtkLabel">
								<property name="label">HIDDEN</property>
								<property name="css-classes">caption-heading
									section-heading
								</property>
								<property name="halign">1</property>
							</object>
						</child>
						<child>
							<object class="GtkSeparator">
								<property name="css-classes">accent-rule</property>
							</object>
						</child>
						<child>
							<object class="GtkFlowBox">
								<property name="max-children-per-line">3</property>
								<property name="css-classes">attribute-list</property>
								<property name="selection-mode">0</property>
								<child>
									<object class="GtkBox" id="row:attribute:hidden:adaptability">
										<property name="css-classes">attr-row</property>
										<child>
											<object class="GtkLabel">
												<property name="label">Adaptability</property>
												<property name="hexpand">true</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object id="label:attribute:hidden:adaptability" class="GtkLabel">
												<property name="label"/>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox" id="row:attribute:hidden:ambition">
										<property name="css-classes">attr-row</property>
										<child>
											<object class="GtkLabel">
												<property name="label">Ambition</property>
												<property name="hexpand">true</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object id="label:attribute:hidden:ambition" class="GtkLabel">
												<property name="label"/>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox" id="row:attribute:hidden:consistency">
										<property name="css-classes">attr-row</property>
										<child>
											<object class="GtkLabel">
												<property name="label">Consistency</property>
												<property name="hexpand">true</property>
												<property name="xalign">0</property>
											</object>
										</child>
										<child>
											<object id="label:attribute:hidden:consistency" class="GtkLabel">
												<property name="label"/>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox" id="row:attribute:hidden:controversy">
										<property name="css-classes">attr-row</property>
										<child>
											<object class="GtkLabel">
												<property name="label">Controversy</property>
												<property name="hexpand">true</property>
												<property name="xalign">0</property>
											</object>
										</child>
