<?xml version="1.0" encoding="UTF-8"?>
<!--
  Yet another Scouting Tool - GTK4 GtkBuilder UI definition.
  See: https://docs.gtk.org/gtk4/class.Builder.html
-->
<interface domain="player-search">
	<!-- interface-name player-search.ui -->
	<!-- interface-copyright SPDX-FileCopyrightText: © 2026 Phil Armstead <philarmstead@mailbox.org>
SPDX-License-Identifier: GPL-3.0-or-later -->
	<!-- interface-authors Phil Armstead <philarmstead@mailbox.org> -->
	<requires lib="gtk" version="4.0"/>
	<object class="GtkPopover" id="popover:club-search">
		<property name="autohide">false</property>
		<property name="can-focus">false</property>
		<property name="position">bottom</property>
		<property name="child">
			<object class="GtkListBox" id="listbox:club-search">
				<property name="can-focus">false</property>
				<property name="selection-mode">none</property>
			</object>
		</property>
	</object>
	<object class="GtkPopover" id="popover:nationality-search">
		<property name="autohide">false</property>
		<property name="can-focus">false</property>
		<property name="position">bottom</property>
		<property name="child">
			<object class="GtkListBox" id="listbox:nationality-search">
				<property name="can-focus">false</property>
				<property name="selection-mode">none</property>
			</object>
		</property>
	</object>
	<object class="GtkWindow" id="window:player-search">
		<property name="title">Yet another Scouting Tool</property>
		<property name="default-width">1255</property>
		<property name="default-height">690</property>
		<child>
			<object class="GtkBox">
				<property name="orientation">vertical</property>
				<property name="css-classes">app-root</property>
				<child>
					<object class="GtkBox">
						<property name="css-classes">topbar</property>
						<property name="spacing">4</property>
						<child>
							<object class="GtkLabel">
								<property name="label">Show:</property>
								<property name="css-classes">strong</property>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Current player</property>
								<property name="tooltip-text">Open the player shown in-game (Ctrl+P)</property>
								<signal name="clicked" handler="callbacks_onShowCurrentPlayer"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Best XI</property>
								<property name="tooltip-text">Best XI from the search results (Ctrl+B)</property>
								<signal name="clicked" handler="callbacks_onShowBestEleven"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Squad Depth</property>
								<property name="tooltip-text">Squad depth from the search results (Ctrl+D)</property>
								<signal name="clicked" handler="callbacks_onShowSquadDepth"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Shortlist</property>
								<property name="tooltip-text">Your shortlisted players and how they have changed (Ctrl+L)</property>
								<signal name="clicked" handler="callbacks_onShowShortlist"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">My Squad</property>
								<property name="tooltip-text">Squad depth and the squad planner for the club you manage (Ctrl+M)</property>
								<signal name="clicked" handler="callbacks_onShowMySquad"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Settings</property>
								<property name="tooltip-text">Your club, formations and rating weights (Ctrl+,)</property>
								<signal name="clicked" handler="callbacks_onShowSettings"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkBox">
								<property name="hexpand">true</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:date">
								<property name="label"/>
								<style>
									<class name="date"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:version">
								<property name="label"/>
								<style>
									<class name="version"/>
								</style>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">horizontal</property>
						<property name="vexpand">true</property>
						<property name="css-classes">body</property>
						<child>
							<object class="GtkScrolledWindow">
								<property name="hscrollbar-policy">never</property>
								<property name="vscrollbar-policy">automatic</property>
								<property name="width-request">240</property>
								<!-- Set explicitly so the dropdowns' hexpand does not propagate and widen the sidebar -->
								<property name="hexpand">false</property>
								<property name="css-classes">sidebar-scroll</property>
								<child>
									<object class="GtkBox" id="box:sidebar">
										<property name="orientation">vertical</property>
										<property name="width-request">190</property>
										<property name="spacing">6</property>
										<property name="css-classes">sidebar</property>
										<child>
											<object class="GtkLabel">
												<property name="label">FILTERS</property>
												<property name="halign">start</property>
												<property name="hexpand">false</property>
												<style>
													<class name="section-title"/>
												</style>
											</object>
										</child>

										<child>
											<object class="GtkSearchEntry" id="entry:name">
												<property name="placeholder-text">Search by name (Ctrl+F)</property>
												<property name="css-classes">sidebar-search</property>
												<signal name="search-changed" handler="callbacks_onNameSearchChanged"/>
											</object>
										</child>
										<child>
											<object class="GtkSearchEntry" id="entry:club">
												<property name="placeholder-text">Filter by club</property>
												<property name="css-classes">sidebar-search</property>
											</object>
										</child>
										<child>
											<object class="GtkSearchEntry" id="entry:nationality">
												<property name="placeholder-text">Filter by nation</property>
												<property name="css-classes">sidebar-search</property>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="orientation">vertical</property>
												<property name="spacing">6</property>
												<property name="css-classes">quality-body</property>
												<child>
													<object class="GtkBox">
														<property name="spacing">4</property>
														<style>
															<class name="quality-row"/>
														</style>
														<child>
															<object class="GtkLabel">
																<property name="label">Age</property>
																<property name="halign">start</property>
																<style>
																	<class name="quality-label"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:age:min">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
														<child>
															<object class="GtkLabel">
																<property name="label">-</property>
																<style>
																	<class name="quality-dash"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:age:max">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
													</object>
												</child>
												<child>
													<object class="GtkBox">
														<property name="spacing">4</property>
														<style>
															<class name="quality-row"/>
														</style>
														<child>
															<object class="GtkLabel">
																<property name="label">CA</property>
																<property name="halign">start</property>
																<style>
																	<class name="quality-label"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:ca:min">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
														<child>
															<object class="GtkLabel">
																<property name="label">-</property>
																<style>
																	<class name="quality-dash"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:ca:max">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
													</object>
												</child>
												<child>
													<object class="GtkBox">
														<property name="spacing">4</property>
														<style>
															<class name="quality-row"/>
														</style>
														<child>
															<object class="GtkLabel">
																<property name="label">PA</property>
																<property name="halign">start</property>
																<style>
																	<class name="quality-label"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:pa:min">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
														<child>
															<object class="GtkLabel">
																<property name="label">-</property>
																<style>
																	<class name="quality-dash"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:pa:max">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
													</object>
												</child>
												<child>
													<object class="GtkBox">
														<property name="spacing">4</property>
														<style>
															<class name="quality-row"/>
														</style>
														<child>
															<object class="GtkLabel">
																<property name="label">Rating</property>
																<property name="halign">start</property>
																<style>
																	<class name="quality-label"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:rating:min">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
														<child>
															<object class="GtkLabel">
																<property name="label">-</property>
																<style>
																	<class name="quality-dash"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:rating:max">
																<property name="max-width-chars">3</property>
																<property name="width-chars">3</property>
																<property name="css-classes">quality-entry</property>
															</object>
														</child>
													</object>
												</child>
												<child>
													<object class="GtkBox">
														<property name="spacing">4</property>
														<style>
															<class name="quality-row"/>
														</style>
														<child>
															<object class="GtkLabel">
																<property name="label">Value</property>
																<property name="halign">start</property>
																<style>
																	<class name="quality-label"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:value:min">
																<property name="max-width-chars">5</property>
																<property name="width-chars">5</property>
																<property name="css-classes">quality-entry</property>
																<property name="tooltip-text">Accepts shorthand such as 750k or 2.5m</property>
															</object>
														</child>
														<child>
															<object class="GtkLabel">
																<property name="label">-</property>
																<style>
																	<class name="quality-dash"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkEntry" id="entry:value:max">
																<property name="max-width-chars">5</property>
																<property name="width-chars">5</property>
																<property name="css-classes">quality-entry</property>
																<property name="tooltip-text">Accepts shorthand such as 750k or 2.5m</property>
															</object>
														</child>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkExpander">
												<property name="css-classes">filter-section</property>
												<property name="label-widget">
													<object class="GtkLabel">
														<property name="label">REPUTATION</property>
														<style>
															<class name="section-title"/>
														</style>
													</object>
												</property>
												<property name="child">
													<object class="GtkBox">
														<property name="orientation">vertical</property>
														<property name="spacing">6</property>
														<property name="css-classes">quality-body</property>
														<child>
															<object class="GtkBox">
																<property name="spacing">4</property>
																<style>
																	<class name="quality-row"/>
																</style>
																<child>
																	<object class="GtkLabel">
																		<property name="label">Home</property>
																		<property name="halign">start</property>
																		<style>
																			<class name="quality-label"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:reputation:home:min">
																		<property name="max-width-chars">5</property>
																		<property name="width-chars">5</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">0 to 10,000</property>
																	</object>
																</child>
																<child>
																	<object class="GtkLabel">
																		<property name="label">-</property>
																		<style>
																			<class name="quality-dash"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:reputation:home:max">
																		<property name="max-width-chars">5</property>
																		<property name="width-chars">5</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">0 to 10,000</property>
																	</object>
																</child>
															</object>
														</child>
														<child>
															<object class="GtkBox">
																<property name="spacing">4</property>
																<style>
																	<class name="quality-row"/>
																</style>
																<child>
																	<object class="GtkLabel">
																		<property name="label">Current</property>
																		<property name="halign">start</property>
																		<style>
																			<class name="quality-label"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:reputation:current:min">
																		<property name="max-width-chars">5</property>
																		<property name="width-chars">5</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">0 to 10,000</property>
																	</object>
																</child>
																<child>
																	<object class="GtkLabel">
																		<property name="label">-</property>
																		<style>
																			<class name="quality-dash"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:reputation:current:max">
																		<property name="max-width-chars">5</property>
																		<property name="width-chars">5</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">0 to 10,000</property>
																	</object>
																</child>
															</object>
														</child>
														<child>
															<object class="GtkBox">
																<property name="spacing">4</property>
																<style>
																	<class name="quality-row"/>
																</style>
																<child>
																	<object class="GtkLabel">
																		<property name="label">World</property>
																		<property name="halign">start</property>
																		<style>
																			<class name="quality-label"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:reputation:world:min">
																		<property name="max-width-chars">5</property>
																		<property name="width-chars">5</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">0 to 10,000</property>
																	</object>
																</child>
																<child>
																	<object class="GtkLabel">
																		<property name="label">-</property>
																		<style>
																			<class name="quality-dash"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:reputation:world:max">
																		<property name="max-width-chars">5</property>
																		<property name="width-chars">5</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">0 to 10,000</property>
																	</object>
																</child>
															</object>
														</child>
													</object>
												</property>
											</object>
										</child>
										<child>
											<object class="GtkExpander">
												<property name="css-classes">filter-section</property>
												<property name="label-widget">
													<object class="GtkLabel">
														<property name="label">CONTRACT</property>
														<style>
															<class name="section-title"/>
														</style>
													</object>
												</property>
												<property name="child">
													<object class="GtkBox">
														<property name="orientation">vertical</property>
														<property name="spacing">6</property>
														<property name="css-classes">quality-body</property>
														<child>
															<object class="GtkBox">
																<property name="spacing">4</property>
																<style>
																	<class name="quality-row"/>
																</style>
																<child>
																	<object class="GtkLabel">
																		<property name="label">Max wage</property>
																		<property name="halign">start</property>
																		<style>
																			<class name="quality-label-wide"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:wage:max">
																		<property name="max-width-chars">6</property>
																		<property name="width-chars">6</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">Per week. Accepts shorthand such as 750k or 2.5m</property>
																	</object>
																</child>
															</object>
														</child>
														<child>
															<object class="GtkBox">
																<property name="spacing">4</property>
																<style>
																	<class name="quality-row"/>
																</style>
																<child>
																	<object class="GtkLabel">
																		<property name="label">Expires in ≤</property>
																		<property name="halign">start</property>
																		<style>
																			<class name="quality-label-wide"/>
																		</style>
																	</object>
																</child>
																<child>
																	<object class="GtkEntry" id="entry:contract:months">
																		<property name="max-width-chars">3</property>
																		<property name="width-chars">3</property>
																		<property name="css-classes">quality-entry</property>
																		<property name="tooltip-text">Contracts ending within this many months</property>
																	</object>
																</child>
																<child>
																	<object class="GtkLabel">
																		<property name="label">months</property>
																		<property name="halign">start</property>
																		<style>
																			<class name="quality-dash"/>
																		</style>
																	</object>
																</child>
															</object>
														</child>
														<child>
															<object class="GtkDropDown" id="dropdown:transfer-status">
																<property name="hexpand">true</property>
																<property name="model">
																	<object class="GtkStringList">
																		<items>
																			<item>Any transfer status</item>
																			<item>Transfer listed</item>
																			<item>Loan listed</item>
																			<item>Transfer or loan listed</item>
																		</items>
																	</object>
																</property>
																<signal name="notify::selected" handler="callbacks_onFilterDropDownChanged"/>
																<style>
																	<class name="sidebar-dropdown"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkCheckButton" id="checkbox:unattached">
																<property name="label">Unattached only</property>
																<property name="tooltip-text">Players without a club</property>
																<signal name="toggled" handler="callbacks_onPositionToggled"/>
																<style>
																	<class name="sidebar-check"/>
																</style>
															</object>
														</child>
														<child>
															<object class="GtkCheckButton" id="checkbox:likely-to-join">
																<property name="label">Likely to join my club</property>
																<property name="tooltip-text">An estimate from reputation: neither the player nor their club is much more reputable than your club. Set your club in Settings.</property>
																<signal name="toggled" handler="callbacks_onPositionToggled"/>
																<style>
